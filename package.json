{
    "name": "country-data-list",
    "version": "1.7.0",
    "description": "Data about countries - like their ISO codes and currencies",
    "homepage": "https://github.com/Sonatrix/country-list",
    "bugs": {
        "url": "https://github.com/Sonatrix/country-list/issues"
    },
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "browser": "dist/country-data-list.min.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./esm": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/country-data-list.esm.js"
            }
        },
        "./umd": {
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/country-data-list.umd.js"
            }
        },
        "./data/countries": {
            "import": {
                "types": "./dist/data/countries.d.ts",
                "default": "./dist/data/countries.module.js"
            },
            "require": {
                "types": "./dist/data/countries.d.cts",
                "default": "./dist/data/countries.cjs"
            }
        },
        "./data/continents": {
            "import": {
                "types": "./dist/data/continents.d.ts",
                "default": "./dist/data/continents.module.js"
            },
            "require": {
                "types": "./dist/data/continents.d.cts",
                "default": "./dist/data/continents.cjs"
            }
        },
        "./data/currencies": {
            "import": {
                "types": "./dist/data/currencies.d.ts",
                "default": "./dist/data/currencies.module.js"
            },
            "require": {
                "types": "./dist/data/currencies.d.cts",
                "default": "./dist/data/currencies.cjs"
            }
        },
        "./data/languages": {
            "import": {
                "types": "./dist/data/languages.d.ts",
                "default": "./dist/data/languages.module.js"
            },
            "require": {
                "types": "./dist/data/languages.d.cts",
                "default": "./dist/data/languages.cjs"
            }
        },
        "./data/regions": {
            "import": {
                "types": "./dist/data/regions.d.ts",
                "default": "./dist/data/regions.module.js"
            },
            "require": {
                "types": "./dist/data/regions.d.cts",
                "default": "./dist/data/regions.cjs"
            }
        },
        "./data/currency-symbol": {
            "import": {
                "types": "./dist/data/currency-symbol.d.ts",
                "default": "./dist/data/currency-symbol.module.js"
            },
            "require": {
                "types": "./dist/data/currency-symbol.d.cts",
                "default": "./dist/data/currency-symbol.cjs"
            }
        },
        "./data/timezones": {
            "import": {
                "types": "./dist/data/timezones.d.ts",
                "default": "./dist/data/timezones.module.js"
            },
            "require": {
                "types": "./dist/data/timezones.d.cts",
                "default": "./dist/data/timezones.cjs"
            }
        }
    },
    "sideEffects": false,
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --config .prettierrc --write"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc && npm run copy-data && npm run build-modules && npm run copy-types && npm run pack",
        "copy-data": "cp src/data/*.js dist/data/",
        "build-modules": "cp src/data/*.module.js dist/data/",
        "copy-types": "node scripts/copy-types.js",
        "pack": "rollup -c",
        "analyze": "rollup -c --environment ANALYZE:true",
        "tree-shaking-test": "rollup examples/tree-shaking.js -f esm -o dist/tree-shaking-example.js",
        "test": "mocha",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "prepare": "npm run lint:fix && npm run test && npm run build",
        "prettify": "prettier --config .prettierrc --write '*/**/*.js'"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/sonatrix/country-list.git"
    },
    "keywords": [
        "data",
        "country",
        "es6",
        "es2015",
        "esm",
        "typescript",
        "mocha",
        "chai",
        "eslint",
        "travis",
        "travis-ci"
    ],
    "author": "Sonatrix",
    "license": "MIT",
    "devDependencies": {
        "@rollup/plugin-terser": "^1.0.0",
        "chai": "^6.2.2",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.3",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.2",
        "mocha": "^11.0.0",
        "prettier": "^3.6.2",
        "rollup": "^4.60.1",
        "typescript": "^5.9.2"
    }
}
